# data-world / dag-factory 运行时配置示例。
# 复制为 .env 后填写真实值；.env 已被 Git 忽略，请勿提交密钥。

# 模型服务鉴权 Token
ANTHROPIC_AUTH_TOKEN=your-token-here

# 模型服务的 OpenAI / Anthropic 兼容 base URL
# 如果地址以 /anthropic 结尾，OpenAI 兼容调用会自动移除该后缀。
ANTHROPIC_BASE_URL=https://your-model-endpoint.example/v1

# dag-factory、World Contract 和轨迹采集使用的实际模型名称
ANTHROPIC_MODEL=your-model-name

# 可选：仅在使用 --log-trajectories 且 ccr 不在 PATH 时配置
# CCR_BIN=/absolute/path/to/ccr

# 可选：CCR 上游 429/5xx 的重试次数（0–20，默认 4）
# CCR_RETRY_COUNT=8

# 可选：task export / Harbor verifier 的 judge 覆盖；不配置则回退到上面的 ANTHROPIC_*。
# JUDGE_API=openai
# JUDGE_MODEL=your-judge-model
# JUDGE_BASE_URL=https://your-judge-endpoint.example/v1
# JUDGE_API_KEY=your-judge-token
