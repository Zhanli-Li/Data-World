        "date",
        "industry_growth_rate",
        "competitor_ad_spend_index",
        "seasonality_index"
      ],
      "system": "Data Warehouse",
      "grain": "按月聚合"
    },
    {
      "label": "Marketing Spend & Channel Mix",
      "variables": [
        "date",
